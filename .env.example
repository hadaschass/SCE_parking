# Copy this file to .env and fill in real values for your machine.
# .env is git-ignored and must never be committed.

# Server
PORT=3000
NODE_ENV=development

# Auth
# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret_value
JWT_EXPIRES_IN=2h
# bcrypt cost factor (10-12 is a reasonable range)
BCRYPT_SALT_ROUNDS=12

# Database (SQLite file path used outside of tests; tests always use an
# in-memory database regardless of this value)
DB_STORAGE=./database/development.sqlite

# Only needed if you switch config/config.js "production" to a
# client/server database such as Postgres or MySQL instead of SQLite:
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=replace_me
# DB_PASSWORD=replace_me
# DB_NAME=parking_permits

# CORS: origin allowed to call the API from a browser (use your frontend's
# URL in production instead of *)
CORS_ORIGIN=*

# Business rule: how long an approved permit stays valid, in days
PERMIT_VALIDITY_DAYS=365
